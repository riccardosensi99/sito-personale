# Variante HTTP: l'origine parla in chiaro e la cifratura verso il visitatore la mette
# Cloudflare. Va bene in locale e con Cloudflare in modalità Flexible — per Full (strict)
# usa docker-compose.tls.yml, che monta nginx-tls.conf.template al posto di questo.
#
# Reso da envsubst all'avvio del container: l'unica variabile sostituita è ${ADMIN_PATH}
# (NGINX_ENVSUBST_FILTER nel compose evita che tocchi $uri, $host e simili).

# try_files /index.html fa una internal redirect e riprocessa i location: gli header
# del backoffice vanno quindi decisi sull'URI originale, non sul file servito.
# ROBOTS_DEFAULT è vuoto in produzione; negli ambienti di prova vale "noindex, nofollow"
# così i motori non finiscono per indicizzare una copia del sito.
map $request_uri $robots_tag {
  default                "${ROBOTS_DEFAULT}";
  ~^/${ADMIN_PATH}       "noindex, nofollow, noarchive";
}

map $request_uri $html_cache {
  default                "no-cache";
  ~^/${ADMIN_PATH}       "no-store";
}

# Protocollo visto dal visitatore: quello dichiarato da Cloudflare se c'è, altrimenti il nostro.
map $http_x_forwarded_proto $fwd_proto {
  default  $scheme;
  "~.+"    $http_x_forwarded_proto;
}

server {
  listen 80;
  server_name _;

  include /etc/nginx/snippets/site-locations.conf;
}
