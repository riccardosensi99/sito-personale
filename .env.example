# ─── Ambiente ────────────────────────────────────────────────────────────────
# Isola container, rete e volumi da quelli degli altri ambienti sulla stessa macchina.
#   local e prod:  riccardosensi        staging:  riccardosensi-staging
COMPOSE_PROJECT_NAME=riccardosensi

# ─── Database ────────────────────────────────────────────────────────────────
POSTGRES_USER=rs
POSTGRES_PASSWORD=cambiami
POSTGRES_DB=riccardosensi
# In docker l'host è il nome del servizio; in locale senza docker usa localhost:${DB_PORT}
DATABASE_URL=postgresql://rs:cambiami@localhost:5434/riccardosensi?schema=public

# Porte esposte sull'host in sviluppo (cambiale se sono già occupate)
DB_PORT=5434
API_DEV_PORT=3000
WEB_DEV_PORT=5174
# Porta pubblicata dal frontend in produzione
WEB_PORT=80
# Interfaccia su cui pubblicarla. Con Cloudflare Tunnel metti 127.0.0.1:
# nginx resta raggiungibile solo dal server e il firewall può restare chiuso.
WEB_BIND=0.0.0.0

# ─── Cloudflare Tunnel (solo con docker-compose.tunnel.yml) ──────────────────
# Zero Trust → Networks → Tunnels → crea il tunnel e copia il token
CLOUDFLARE_TUNNEL_TOKEN=

# ─── API ─────────────────────────────────────────────────────────────────────
NODE_ENV=development
API_PORT=3000
# openssl rand -hex 48
JWT_SECRET=sostituiscimi-con-una-stringa-random-lunga
# Dominio su cui viene impostato il cookie di sessione (vuoto = host corrente)
COOKIE_DOMAIN=
# Origini ammesse dal CORS, separate da virgola
CORS_ORIGINS=http://localhost:5173,http://localhost:5174
# Cartella dove finiscono le immagini caricate dal backoffice
UPLOAD_DIR=/data/uploads

# ─── Admin (usati solo dal seed) ─────────────────────────────────────────────
ADMIN_EMAIL=riccardosensi57@gmail.com
ADMIN_PASSWORD=cambiami-al-primo-avvio

# ─── GitHub ──────────────────────────────────────────────────────────────────
GITHUB_USERNAME=riccardosensi99
# Personal access token read-only (public_repo o nessuno scope per soli repo pubblici)
GITHUB_TOKEN=

# ─── Frontend (build-time) ───────────────────────────────────────────────────
VITE_API_URL=/api
# Path segreto del backoffice, senza slash iniziale
VITE_ADMIN_PATH=cn-riccardo-2f
# Indirizzo pubblico dell'ambiente: finisce in canonical, og:url e dati strutturati
VITE_SITE_URL=https://riccardosensi.com

# Vuoto in produzione. Negli ambienti di prova metti "noindex, nofollow":
# nginx lo manda come X-Robots-Tag su tutto il sito.
ROBOTS_DEFAULT=

# ─── Accesso riservato (staging) ─────────────────────────────────────────────
# Se valorizzate, nginx chiede utente e password prima di servire qualunque pagina.
# In produzione vanno lasciate vuote.
BASIC_AUTH_USER=
BASIC_AUTH_PASSWORD=
